	(text "REVISIONS (see CHANGELOG.md)\n\nV1.00\n  - First release (2026-07-10)\nV1.11\n  - 1.1 X1&X2 terminals moved on bottom side\n  - 1.2 CN1 5&7&9 pins mirrored with 6&8&10\n  - 1.3 CN1 is replaced by B10B-PHDSS-LF-SN (vertical)\n  - 1.4 CN1 5&7 added I2C for temp sensor AHT20\n  - 1.5 CN1 moved on bottom side\n  - 1.6 FIDs deleted\n  - 3.1 Added FAN_PWM on GPIO35\n  - 4.1 Added pulldown res 0402 R41=5.1K (RST for BM1370)\n  - 4.2 Added pullup 4.7K for I2C\n  - 5.1 Deleted FAN_PWM control from EMC2101\n  - 6.1 R29=R30=4.7Ohm\n  - 6.2 R20=2MOhm, R26=220K\n  - 6.3 L2 is replaced by FXL1050-4R7-M\nV1.22\n  - 3.1 Removed FAN_PWM from GPIO35\n  - 5.1 Added FAN_PWM to EMC2101"
		(exclude_from_sim no)
		(at 110.8499 72.6711 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "a3dab4c4-8cdd-4c3c-aa85-c133c8ba1c50")
	)
